<?xml version="1.0" encoding="utf-8"?>
<!-- Every folder a file is shared from (Intents.shareFile) must be listed here, or the share crashes (judge F15 2026-11-05). FileProviderPathsTest checks each one. -->
<paths>
    <cache-path name="exports" path="exports/" />
    <cache-path name="logs" path="logs/" />
    <cache-path name="change_orders" path="change-orders/" />
    <cache-path name="reports" path="reports/" />
    <cache-path name="downloads" path="downloads/" />
    <files-path name="media" path="media/" />
    <files-path name="offline_files" path="offline-files/" />
</paths>
