}, {
  "command" : {
    "runScriptCommand" : {
      "script" : "// Maestro script: ask the local backend (wrangler dev) for the last sign-in code it issued to\n// EMAIL. The endpoint exists only when the Worker runs with ENVIRONMENT=dev (PLAN Q005); on a\n// deployed backend it returns 404 and output.devCode stays empty; every calling flow asserts the\n// code is not empty, so a backend that never answered fails the flow instead of skipping sign-in.\nvar base = (typeof QA_BACKEND !== 'undefined' && QA_BACKEND) ? QA_BACKEND : 'http://127.0.0.1:8787';\noutput.devCode = '';\ntry {\n  var r = http.get(base + '/dev/last-code?email=' + encodeURIComponent(EMAIL));\n  if (r.ok) {\n    var body = json(r.body);\n    if (body && body.code) { output.devCode = String(body.code); }\n  }\n} catch (e) {\n  console.log('dev code lookup failed: ' + e);\n}\n",
      "env" : {
        "EMAIL" : "${EMAIL}"
      },
      "sourceDescription" : "../_scripts/fetch-dev-code.js",
      "optional" : false,
      "scriptDir" : "/home/runner/work/home-record/home-record/qa/flows/_scripts"
    }
  },
  "metadata" : {
    "status" : "COMPLETED",
    "timestamp" : 1795881603716,
    "duration" : 53,
    "sequenceNumber" : 24,
    "depth" : 0,
